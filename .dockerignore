# Root .dockerignore — used by apps/tessara-server/deployment/Dockerfile.dev,
# whose build context is the whole workspace (it builds tessara-core from
# local source via the uv workspace, not a published package). The
# production Dockerfile uses apps/tessara-server/.dockerignore instead — its
# context is just that directory.

# Version control
.git
.gitignore

# Python
__pycache__
*.pyc
*.pyo
*.pyd
.Python
*.so
*.egg
*.egg-info
build
.pytest_cache
.mypy_cache
.ruff_cache
.coverage
htmlcov/

# Virtual environments
.venv
venv
env
ENV

# Node — reinstalled/rebuilt in the frontend-builder stage
node_modules
apps/tessara-server/static/js/dist

# IDE
.vscode
.idea
*.swp
*.swo
*~
.DS_Store
*.iml

# Not needed to build/run the server image
apps/tessara-cli
docs/
*.md

# (deployment/ itself is kept — docker-entrypoint.sh lives there and is
# COPYed as part of apps/tessara-server; it's tiny)

# Local data / secrets — never bake these into an image
apps/tessara-server/data/
apps/tessara-server/.env
apps/tessara-server/.env.*

# Tests
apps/tessara-server/tests/
packages/tessara-core/tests/
