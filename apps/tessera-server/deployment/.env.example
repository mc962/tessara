# Copy to .env in this directory (apps/tessera-server/deployment/) and fill
# in. docker-compose auto-loads .env from this directory regardless of
# whether you run docker-compose.yml (production) or docker-compose.dev.yml
# (development) — vars the one you're not using doesn't reference are just
# ignored.

# Used by both stacks.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
# Only needed if tessera-server sits behind a reverse proxy.
TRUSTED_PROXY_IP=
# Host port to publish the app on (container always listens on 8000 internally).
TESSERA_PORT=8123

# Production only (docker-compose.yml) — Postgres + wherever tessera-core is published.
POSTGRES_PASSWORD=
UV_INDEX_URL=https://pypi.org/simple
