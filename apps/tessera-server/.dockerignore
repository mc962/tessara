# Used by deployment/Dockerfile (production) — its build context is this
# directory. Dockerfile.dev uses the repo-root .dockerignore instead (its
# context is the whole workspace).

# Version control
.git
.gitignore

# Python
__pycache__
*.pyc
*.pyo
*.pyd
.Python
*.so
*.egg
*.egg-info
build
.pytest_cache
.mypy_cache
.ruff_cache
.coverage
htmlcov/

# Virtual environments
.venv
venv
env
ENV

# Node — reinstalled/rebuilt in the frontend stage
node_modules
static/js/dist

# IDE
.vscode
.idea
*.swp
*.swo
*~
.DS_Store
*.iml

# Local data / secrets — never bake these into an image
data/
.env
.env.*

# Tests
tests/
