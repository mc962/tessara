# Copy to /etc/tessara-server.env on the LXC (root-owned, chmod 600 — this
# holds a secret) and fill in.

APP_ENV=prd
HOST=0.0.0.0
PORT=8000

# Postgres, matching the production Docker stack. For a simpler single-node
# setup, sqlite is still fully supported — swap this block for:
#   DATABASE__KIND=sqlite
#   DATABASE__PATH=/opt/tessara-server/data/tessara.db
DATABASE__KIND=postgres
DATABASE__HOST=
DATABASE__PORT=5432
DATABASE__USER=tessara
DATABASE__PASSWORD=
DATABASE__DATABASE=tessara

# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Only needed if tessara-server sits behind a reverse proxy.
TRUSTED_PROXY_IP=

# Absolute URL this instance is reachable at — embedded in verification/
# password-reset email links. Must match the real public address (through
# whatever reverse proxy fronts this LXC), not localhost.
PUBLIC_BASE_URL=https://tessara.example.com

# SMTP — sends signup verification and password-reset emails. Leave unset
# to degrade to logging the link instead (check journalctl -u tessara-server)
# rather than sending — only acceptable if signups are trusted/closed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_ADDRESS=noreply@example.com

# gunicorn.conf.py writes gunicorn-access.log / gunicorn-error.log here if
# set; falls back to stdout/stderr (captured by journald) if unset.
LOG_DIR=/var/log/tessara-server
