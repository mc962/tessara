# DEVELOPMENT image — builds tessara-core from local source via the uv
# workspace, and defaults to SQLite. See Dockerfile (no suffix) for the
# production image, which installs tessara-core as a real published
# dependency instead and expects Postgres.
#
# Build context is the repo root (see ../../../.dockerignore), not this
# directory — the workspace-local tessara-core build needs the whole
# monorepo present to resolve it.
#
# Build from the repo root with:
#   docker build -f apps/tessara-server/deployment/Dockerfile.dev -t tessara-server:dev .

# ======================================
# Stage 1: frontend assets (esbuild)
# ======================================
FROM node:24-slim AS frontend

WORKDIR /workspace/apps/tessara-server

COPY apps/tessara-server/package.json apps/tessara-server/package-lock.json ./
RUN npm ci

COPY apps/tessara-server/build.mjs ./
COPY apps/tessara-server/static/js/src static/js/src
RUN npm run build

# ======================================
# Stage 2: Python dependencies (uv)
# ======================================
FROM python:3.13-slim AS python-deps

COPY --from=ghcr.io/astral-sh/uv:0.9 /uv /uvx /bin/

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# cairosvg (a tessara-core dependency) needs libcairo2's headers to build its
# native extension at install time — the runtime stage below only needs the
# shared library itself, not the -dev headers.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential libcairo2-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# The whole workspace, not just apps/tessara-server: uv needs
# packages/tessara-core's real source to resolve/build it as a workspace
# member (it's a path dependency, so there's no dependency-only cache layer
# to split out here the way a single-package project could).
COPY pyproject.toml uv.lock ./
COPY packages/tessara-core packages/tessara-core
COPY apps/tessara-server apps/tessara-server

# Editable, not --no-editable: tessara-server's PROJECT_ROOT (constants.py)
# is computed from __file__ and assumes the source tree's original nesting
# (src/tessara_server/.. == apps/tessara-server, where static/ and
# templates/ actually live) — that only holds for an editable install. A
# --no-editable wheel install puts tessara_server in site-packages instead,
# which breaks static/template resolution entirely. tessara-server is never
# meant to be a published wheel anyway (always deployed from a source
# checkout), so editable is the correct mode here, not a workaround.
RUN uv sync --frozen --no-dev --package tessara-server \
    --extra sqlite --extra metrics

# ======================================
# Stage 3: runtime
# ======================================
FROM python:3.13-slim AS runtime

# Just the shared library cairosvg loads at import time — no compiler needed.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libcairo2 \
    && rm -rf /var/lib/apt/lists/*

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/workspace/.venv/bin:$PATH"

WORKDIR /workspace/apps/tessara-server

COPY --from=python-deps /workspace /workspace
COPY --from=frontend /workspace/apps/tessara-server/static/js/dist static/js/dist

EXPOSE 8000

# No curl/wget in python:3.13-slim — stdlib urllib instead of adding a package.
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=2)" || exit 1

# Migrations are a deliberate deploy step, not something that happens
# implicitly on every container start/restart — run them yourself, e.g.:
#   docker compose -f docker-compose.dev.yml run --rm tessara-server alembic upgrade head
CMD ["gunicorn", "-c", "gunicorn.conf.py"]
