# Copy to .env in this directory (apps/tessara-server/deployment/) and fill
# in. docker-compose auto-loads .env from this directory regardless of
# whether you run docker-compose.yml (production) or docker-compose.dev.yml
# (development) — vars the one you're not using doesn't reference are just
# ignored.

# Used by both stacks.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
# Only needed if tessara-server sits behind a reverse proxy.
TRUSTED_PROXY_IP=
# Host port to publish the app on (container always listens on 8000 internally).
TESSARA_PORT=8123

# Absolute URL this instance is reachable at — embedded in verification/
# password-reset email links. Must match how users actually reach it
# (through the reverse proxy / TESSARA_PORT), not the container-internal
# address.
PUBLIC_BASE_URL=http://localhost:8123

# SMTP — sends signup verification and password-reset emails. Leave unset
# to degrade to logging the link instead of sending (fine for a closed
# homelab deployment where you can just check `docker compose logs`, not
# for anything with real self-service signups).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_ADDRESS=noreply@example.com

# Production only (docker-compose.yml) — Postgres + wherever tessara-core is published.
POSTGRES_PASSWORD=
UV_INDEX_URL=https://pypi.org/simple
